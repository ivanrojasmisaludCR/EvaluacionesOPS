# Copia a .env o ejecuta npm run prepare:local para generar una clave.
AGORA_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_PROPIA
PORT=3000
# Opcional: dirección visible desde los teléfonos; también se configura en la sala.
# AGORA_PUBLIC_URL=http://192.168.1.20:3000
# AGORA_DATA_DIR=data
# Docker habilita el enlace temporal de Cloudflare por defecto.
# AGORA_TUNNEL_ENABLED=false
# En modo local, true requiere instalar cloudflared o indicar su ruta.
# AGORA_CLOUDFLARED_PATH=/ruta/a/cloudflared
