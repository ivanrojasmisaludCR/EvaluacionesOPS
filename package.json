{
  "name": "agora-evaluaciones-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "dev": "node --env-file-if-exists=.env --watch server/main.ts",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "prepare:local": "node scripts/prepare-local.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
